#!/bin/bash

floating=$(hyprctl activewindow -j | jq '.floating')

function toggle() {
  width=$1
  height=$2

  hyprctl --batch "dispatch togglefloating; dispatch resizeactive exact ${width} ${height}; dispatch centerwindow"
}

function untoggle() {
  hyprctl dispatch togglefloating
}

function handle() {
  width=$1
  height=$2

  if [ "$floating" == "false" ]; then
    toggle "$width" "$height"
  else
    untoggle
  fi
}

if [ "$#" -lt 2 ]; then
  exit 1
fi

handle "$1" "$2"
